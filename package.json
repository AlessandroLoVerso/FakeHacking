{
  "name": "fakehacking",
  "productName": "FakeHacking",
  "version": "1.0.0",
  "description": "Postazione hacker finta da film, in stile VS Code. Tutto simulato, tutto divertente.",
  "author": "Alessandro Lo Verso",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/d3-geo": "3.1.1",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vscode/codicons": "0.0.45",
    "d3-geo": "3.1.1",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "topojson-client": "3.1.0",
    "typescript": "7.0.2",
    "vite": "8.1.6",
    "vitest": "5.0.3",
    "world-atlas": "2.0.2"
  }
}
